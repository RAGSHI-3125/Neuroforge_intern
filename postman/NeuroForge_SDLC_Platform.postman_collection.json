{
  "info": {
    "name": "NeuroForge SDLC Platform API",
    "description": "Signup/login then use the returned token as the collection-level Bearer token for every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "jwt_token", "value": "" },
    { "key": "project_id", "value": "1" },
    { "key": "task_id", "value": "1" },
    { "key": "user_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ragshi Kumar\",\n  \"email\": \"ragshi@neuroforge.com\",\n  \"password\": \"password123\",\n  \"role\": \"PROJECT_MANAGER\"\n}"
            },
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('jwt_token', data.token);",
                  "  pm.collectionVariables.set('user_id', data.userId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ragshi@neuroforge.com\",\n  \"password\": \"password123\"\n}"
            },
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('jwt_token', data.token);",
                  "  pm.collectionVariables.set('user_id', data.userId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "Get All Users", "request": { "method": "GET", "url": "{{base_url}}/api/users" } },
        { "name": "Get User By Id", "request": { "method": "GET", "url": "{{base_url}}/api/users/{{user_id}}" } },
        { "name": "Get Users By Role", "request": { "method": "GET", "url": "{{base_url}}/api/users?role=SOFTWARE_DEVELOPER" } }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"NeuroForge MVP\",\n  \"description\": \"Initial AI-powered SDLC platform build\",\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2026-06-30\",\n  \"status\": \"PLANNING\",\n  \"managerId\": {{user_id}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('project_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        { "name": "Get All Projects", "request": { "method": "GET", "url": "{{base_url}}/api/projects" } },
        { "name": "Get Project By Id", "request": { "method": "GET", "url": "{{base_url}}/api/projects/{{project_id}}" } },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/projects/{{project_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"NeuroForge MVP\",\n  \"description\": \"Updated description\",\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2026-07-31\",\n  \"status\": \"IN_PROGRESS\",\n  \"managerId\": {{user_id}}\n}"
            }
          }
        },
        { "name": "Delete Project", "request": { "method": "DELETE", "url": "{{base_url}}/api/projects/{{project_id}}" } }
      ]
    },
    {
      "name": "Requirements",
      "item": [
        {
          "name": "Create Requirement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/requirements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"User authentication module\",\n  \"description\": \"Signup/login with JWT\",\n  \"technicalStack\": \"Spring Boot, MySQL\",\n  \"projectId\": {{project_id}},\n  \"createdById\": {{user_id}}\n}"
            }
          }
        },
        { "name": "Get All Requirements", "request": { "method": "GET", "url": "{{base_url}}/api/requirements" } },
        { "name": "Get Requirements By Project", "request": { "method": "GET", "url": "{{base_url}}/api/requirements?projectId={{project_id}}" } }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskName\": \"Build JWT auth filter\",\n  \"description\": \"Implement Spring Security JWT filter\",\n  \"status\": \"TODO\",\n  \"projectId\": {{project_id}},\n  \"assignedToId\": {{user_id}},\n  \"dueDate\": \"2026-02-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('task_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        { "name": "Get All Tasks", "request": { "method": "GET", "url": "{{base_url}}/api/tasks" } },
        { "name": "Get Tasks By Project", "request": { "method": "GET", "url": "{{base_url}}/api/tasks?projectId={{project_id}}" } }
      ]
    },
    {
      "name": "Test Cases",
      "item": [
        {
          "name": "Create Test Case",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/testcases",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Login endpoint returns valid JWT\",\n  \"status\": \"PENDING\",\n  \"noOfTestCases\": 3,\n  \"taskId\": {{task_id}},\n  \"createdById\": {{user_id}}\n}"
            }
          }
        },
        { "name": "Get All Test Cases", "request": { "method": "GET", "url": "{{base_url}}/api/testcases" } },
        { "name": "Get Test Cases By Task", "request": { "method": "GET", "url": "{{base_url}}/api/testcases?taskId={{task_id}}" } }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Create Report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/reports",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportType\": \"BUG_REPORT\",\n  \"bugId\": 101,\n  \"severity\": \"HIGH\",\n  \"description\": \"Token expiry not enforced correctly\",\n  \"projectId\": {{project_id}},\n  \"generatedById\": {{user_id}}\n}"
            }
          }
        },
        { "name": "Get All Reports", "request": { "method": "GET", "url": "{{base_url}}/api/reports" } },
        { "name": "Get Reports By Project", "request": { "method": "GET", "url": "{{base_url}}/api/reports?projectId={{project_id}}" } }
      ]
    }
  ]
}
